{
  "manifest_version": 3,
  "name": "Ithaca Quant | v3.2 Research Companion",
  "description": "Opt-in stock overlay built on Ithaca Quant v3.2 analyst and portfolio intelligence plus historical-data integrity with three fitted ML agents, SEC Form 4 research and weekly audited outcomes.",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ithaca Quant research panel",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://finance.yahoo.com/*",
        "*://*.finance.yahoo.com/*",
        "*://www.google.com/finance/*",
        "*://www.tradingview.com/*",
        "*://*.tradingview.com/*",
        "*://www.marketwatch.com/*",
        "*://www.nasdaq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
